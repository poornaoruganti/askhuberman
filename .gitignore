############################################

# Bytecode / cache
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Virtual environments
**/venv/
**/.venv/
**/env/
**/.env/
**/ENV/

# Python build artifacts
**/build/
**/dist/
**/*.egg-info/
**/.eggs/
**/pip-wheel-metadata/

# Pytest / coverage
**/.pytest_cache/
**/.coverage
**/coverage.xml
**/htmlcov/

# Mypy / Ruff / Pyright / Pylint
**/.mypy_cache/
**/.ruff_cache/
**/.pyright/
**/.pylint.d/

